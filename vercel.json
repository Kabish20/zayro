{
  "version": 2,
  "rewrites": [
    {
      "source": "/salon360-api/(.*)",
      "destination": "/api/salon360"
    },
    {
      "source": "/kknagarinvite/(.*)",
      "destination": "/kknagarinvite/index.html"
    },
    {
      "source": "/kknagarinvite",
      "destination": "/kknagarinvite/index.html"
    },
    {
      "source": "/((?!api/|assets/|images/|icons/|documents/|favicon|robots\\.txt|sitemap\\.xml).*)",
      "destination": "/index.html"
    }
  ]
}

